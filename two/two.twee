<h1 class="bold center">Scene 7 </h1>
<div id="msgMount">
<div class="inline-img-wrapper gramophone">
<img src="../assets/img/grammaphone.gif">
</div>
</div>
<<timed 52s>>
    <<replace "#msgMount">>
        <<addclass "main" "question">>
        <<addclass "#msgMount" "border">>
    <div class="bevell-container">
    <img src="../assets/img/bevell.png" alt="bevel border"/>
</div>
    <p class="bold">Look through the manuscript. Write down anything of interest. </p>
    <<include "pwScene7">>
    <</replace>>
 

<</timed>>


:: pwScene7 [nobr]
<<set $codeword to "">>  /* ensure it's blank so the placeholder shows */

<div class="codeinput">
  <<textbox "$codeword" "">>

  <div class="input-btn">
  <<button "Enter">>
    <<set $codeword to $codeword.toUpperCase().trim()>>

    /* Correct */
    <<if $codeword is "TIMES 17-10-41">>
      <<replace "#coderesult">><span>Correct!</span>
      <</replace>>
       <<addclass "#msgMount" "correctAnswer">>
     <<timed 2s>>
    <<goto $nextpass>>
      <</timed>>
    <<elseif $codeword isnot "">>
      /* Incorrect (non-empty) */
      <<replace "#coderesult">><span>Try again.</span><</replace>>
      <<timed 1.5s>><<replace "#coderesult">><</replace>><</timed>>
    <</if>>
  <</button>>
  </div>
</div>
<br/>
<div id="coderesult"></div>

